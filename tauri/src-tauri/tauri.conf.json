{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MailKlient Tauri",
  "version": "0.5.0",
  "identifier": "io.github.luxinoxix.mailklient.tauri",
  "build": {
    "frontendDist": "../../dist-web"
  },
  "app": {
    "windows": [
      {
        "title": "MailKlient (Tauri – test)",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" },
      "wix": { "language": "sk-SK" }
    }
  }
}
